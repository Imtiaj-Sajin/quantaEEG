# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Run artefacts: logs and mid-run checkpoints are machine-specific noise.
# Final result CSV/JSON and figures ARE committed -- they are the scientific
# record and should travel with the code.
results/*.log
results/*.partial.csv
results/_*/

# Large cached datasets live in ~/mne_data, never in the repo.
mne_data/

# LaTeX build products. The compiled PDF IS tracked -- it is the artefact
# people actually want to read, and a reader should not need a TeX toolchain
# plus the non-CTAN IOP class files just to see the manuscript. Everything
# else in build/ is intermediate.
paper/build/*
!paper/build/main.pdf
*.aux
*.bbl
*.blg
*.out
*.log
*.xdv

# Third-party IOP class files -- fetched by paper/get_iop_class.sh, not
# redistributed here.
paper/iopart.cls
paper/iopart1*.clo
paper/iopams.sty
paper/setstack.sty
paper/harvard.sty
paper/iopart-num.bst

# Screening/smoke outputs. Superseded by the tagged production runs; keeping
# them invites quoting a 2-subject pilot as if it were the n=30 result.
results/*_smoke.csv
results/exp_*.csv
